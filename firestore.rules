rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Users collection
    match /users/{uid} {
      // Users can read and write their own data
      allow read, write: if isAuthenticated() && isOwner(uid);
    }

    // Daily check-ins collection
    match /dailyCheckIns/{docId} {
      // Users can read their own check-ins
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Users can create check-ins for themselves
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;

      // Users cannot update or delete check-ins
      allow update, delete: if false;
    }

    // Usage data collection
    match /usageData/{docId} {
      // Users can read and write their own usage data
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Coach reviews collection
    match /coachReviews/{docId} {
      // Users can only read their own reviews
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Users can update readAt field
      allow update: if isAuthenticated()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);

      // Only admins/coaches can create reviews (will be handled server-side)
      allow create, delete: if false;
    }
  }
}
